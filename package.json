{
    "name": "gcal-cleaner",
    "description": "Google Calendar cleaner app",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "author": "pozil",
    "bugs": "https://github.com/pozil/gcal-cleaner/issues",
    "dependencies": {
        "compression": "^1.8.1",
        "dotenv": "^17.2.1",
        "express": "^5.1.0",
        "express-session": "^1.18.2",
        "googleapis": "^157.0.0",
        "helmet": "^8.1.0",
        "lwc": "^8.20.1",
        "lwr": "^0.18.3"
    },
    "devDependencies": {
        "@salesforce/eslint-config-lwc": "^4.0.0",
        "eslint": "^9.34.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.5",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.6.2"
    },
    "homepage": "https://github.com/pozil/gcal-cleaner",
    "keywords": [
        "lwc",
        "gcal"
    ],
    "license": "CC0-1.0",
    "lint-staged": {
        "**/*.{css,html,js,json,md,ts,yaml,yml}": [
            "prettier --write"
        ],
        "**/*.js": [
            "eslint"
        ]
    },
    "repository": "pozil/gcal-cleaner",
    "scripts": {
        "start": "cross-env MODE=prod node src/server/server.js",
        "dev": "cross-env MODE=dev node src/server/server.js",
        "lint": "eslint .",
        "prettier": "prettier --write \"**/*.{css,html,js,json,md,ts,yaml,yml}\"",
        "prettier:verify": "prettier --list-different \"**/*.{css,html,js,json,md,ts,yaml,yml}\"",
        "prepare": "husky",
        "precommit": "lint-staged"
    },
    "volta": {
        "node": "22.18.0"
    }
}
